<Page x:Class="HeroArena.Views.HeroesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BrushBgDark}">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Liste des héros -->
        <Border Grid.Column="0" Background="#16161A" CornerRadius="6" Padding="16">
            <StackPanel>
                <TextBlock Text="HÉROS DISPONIBLES" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource BrushTextMuted}"
                           Margin="0,0,0,16"/>
                <ListBox x:Name="LstHeroes" Background="Transparent"
                         BorderThickness="0"
                         SelectionChanged="LstHeroes_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8" Margin="0,2" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock FontSize="12"
                                               Foreground="{StaticResource BrushTextMuted}">
                                        <Run Text="HP: "/>
                                        <Run Text="{Binding Health}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#2A2A35"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1E1E28"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- Détail du héros -->
        <Border Grid.Column="1" Background="#16161A" CornerRadius="6"
                Margin="16,0,0,0" Padding="24">
            <Grid>
                <StackPanel x:Name="PanelDetail" Visibility="Collapsed">
                    <TextBlock x:Name="TxtHeroName" FontSize="28" FontWeight="Black"
                               Foreground="{StaticResource BrushAccentGold}"
                               Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <TextBlock Text="HP : " FontSize="14"
                                   Foreground="{StaticResource BrushTextMuted}"/>
                        <TextBlock x:Name="TxtHeroHP" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextPrimary}"/>
                    </StackPanel>

                    <TextBlock Text="SORTS" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextMuted}"
                               Margin="0,0,0,12"/>
                    <ItemsControl x:Name="LstSpells">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0D0D0F" CornerRadius="4"
                                        Padding="14,10" Margin="0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Spell.Name}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="{Binding Spell.Description}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource BrushTextMuted}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#C9A84C22"
                                                CornerRadius="3" Padding="8,4">
                                            <TextBlock FontSize="13" FontWeight="Bold"
                                                       Foreground="{StaticResource BrushAccentGold}">
                                                <Run Text="{Binding Spell.Damage}"/>
                                                <Run Text=" DMG"/>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button x:Name="BtnSelectHero" Content="CHOISIR CE HÉROS"
                            Style="{StaticResource GoldButton}"
                            Margin="0,24,0,0" Click="BtnSelectHero_Click"/>
                </StackPanel>

                <TextBlock x:Name="TxtPlaceholder" Text="← Sélectionne un héros"
                           FontSize="16" Foreground="{StaticResource BrushTextMuted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Page>