<Page x:Class="HeroArena.Views.CombatView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BrushBgDark}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Score -->
        <Border Grid.Row="0" Background="#16161A" CornerRadius="6"
                Padding="16,10" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="SCORE : " FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource BrushTextMuted}"/>
                <TextBlock x:Name="TxtScore" Text="0" FontSize="14" FontWeight="Black"
                           Foreground="{StaticResource BrushAccentGold}"/>
            </StackPanel>
        </Border>

        <!-- Zone combat : joueur vs ennemi -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Héros joueur -->
            <Border Grid.Column="0" Background="#16161A" CornerRadius="6" Padding="16">
                <StackPanel>
                    <TextBlock x:Name="TxtPlayerName" Text="JOUEUR" FontSize="18"
                               FontWeight="Black" Foreground="{StaticResource BrushAccentGold}"
                               Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="HP : " Foreground="{StaticResource BrushTextMuted}" FontSize="13"/>
                        <TextBlock x:Name="TxtPlayerHP" Foreground="{StaticResource BrushTextPrimary}"
                                   FontSize="13" FontWeight="Bold"/>
                    </StackPanel>
                    <ProgressBar x:Name="PbPlayerHP" Height="12" Maximum="100" Value="100"
                                 Foreground="#4CAF50" Background="#2A2A35"
                                 BorderThickness="0" Margin="0,0,0,12"/>
                    <TextBlock Text="SORTS" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="LstPlayerSpells">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,3" Padding="10,7"
                                        Background="#0D0D0F" BorderThickness="1"
                                        BorderBrush="#3A3A4A" Cursor="Hand"
                                        Click="BtnSpell_Click" Tag="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Spell.Name}"
                                                               Foreground="{StaticResource BrushTextPrimary}"
                                                               FontSize="13"/>
                                                    <TextBlock Grid.Column="1"
                                                               Foreground="{StaticResource BrushAccentGold}"
                                                               FontWeight="Bold" FontSize="13">
                                                        <Run Text="{Binding Spell.Damage}"/>
                                                        <Run Text=" DMG"/>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1E1E28"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource BrushAccentGold}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- VS -->
            <TextBlock Grid.Column="1" Text="VS" FontSize="24" FontWeight="Black"
                       Foreground="{StaticResource BrushAccentRed}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- Héros ennemi -->
            <Border Grid.Column="2" Background="#16161A" CornerRadius="6" Padding="16">
                <StackPanel>
                    <TextBlock x:Name="TxtEnemyName" Text="ENNEMI" FontSize="18"
                               FontWeight="Black" Foreground="{StaticResource BrushAccentRed}"
                               Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="HP : " Foreground="{StaticResource BrushTextMuted}" FontSize="13"/>
                        <TextBlock x:Name="TxtEnemyHP" Foreground="{StaticResource BrushTextPrimary}"
                                   FontSize="13" FontWeight="Bold"/>
                    </StackPanel>
                    <ProgressBar x:Name="PbEnemyHP" Height="12" Maximum="100" Value="100"
                                 Foreground="{StaticResource BrushAccentRed}" Background="#2A2A35"
                                 BorderThickness="0" Margin="0,0,0,12"/>
                    <TextBlock Text="SORTS ENNEMIS" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="LstEnemySpells">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,3" Padding="10,7" Background="#0D0D0F"
                                        BorderBrush="#3A3A4A" BorderThickness="1" CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Spell.Name}"
                                                   Foreground="{StaticResource BrushTextMuted}"
                                                   FontSize="13"/>
                                        <TextBlock Grid.Column="1"
                                                   Foreground="{StaticResource BrushAccentRed}"
                                                   FontWeight="Bold" FontSize="13">
                                            <Run Text="{Binding Spell.Damage}"/>
                                            <Run Text=" DMG"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Log de combat -->
        <Border Grid.Row="2" Background="#16161A" CornerRadius="6" Padding="16">
            <ScrollViewer x:Name="ScrollLog" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="TxtLog" Foreground="{StaticResource BrushTextPrimary}"
                           FontSize="13" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <!-- Boutons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button x:Name="BtnNewCombat" Content="⚔ NOUVEAU COMBAT"
                    Style="{StaticResource GoldButton}"
                    Click="BtnNewCombat_Click" Margin="0,0,8,0"/>
        </StackPanel>
    </Grid>
</Page>